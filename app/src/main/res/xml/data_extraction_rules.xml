<!-- Exclude everything from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include path="." />
        <exclude path="." />
    </cloud-backup>
    <device-transfer>
        <include path="." />
        <exclude path="." />
    </device-transfer>
</data-extraction-rules>
